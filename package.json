{
  "name": "pinxing-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "d0-check": "bun scripts/d0-check.ts",
    "check-upstream": "bun scripts/check-upstream.ts",
    "accept": "node scripts/accept.ts",
    "tour:build": "bun src/tour/build-tours.ts --config tour.config.ts",
