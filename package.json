    "tour:demo": "node scripts/tour-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
